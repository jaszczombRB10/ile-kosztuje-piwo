# Vercel / Production Environment Variables for poilepiwko
# Skonfiguruj te zmienne w panelu Vercel (Project Settings -> Environment Variables)

# Supabase
SUPABASE_URL=https://agsodpzkytdgicpmphxz.supabase.co
SUPABASE_SERVICE_ROLE_KEY=twoj_klucz_service_role_z_supabase_dashboard

# Panel Administratora (/admin.html)
ADMIN_PASSWORD=bezpieczne_haslo_admina

# Gemini AI Vision + Google Search Grounding (Skaner cenników i auto-wyszukiwanie godzin otwarcia)
GEMINI_API_KEY=twoj_klucz_gemini_api_key

# (Opcjonalnie) Google Maps Places API (najświeższe godziny otwarcia z wizytówek Google; bez klucza działa OpenStreetMap)
# GOOGLE_MAPS_API_KEY=twoj_klucz_google_places_api

# (Opcjonalnie) OpenAI Vision
# OPENAI_API_KEY=twoj_klucz_openai_api_key
